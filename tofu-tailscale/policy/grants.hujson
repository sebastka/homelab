{
	// Who reaches what, and on which ports; anything not granted here is denied.
	"grants": [
		// Every member, to their own devices.
		{
			"src": [
				"autogroup:member",
			],
			"dst": [
				"autogroup:self",
			],
			"ip": [
				"*",
			],
		},
		// The home LAN, through the operator's Connector on talmox (k8s/infrastructure/network/tailscale).
		{
			"src": [
				"group:admins",
			],
			"dst": [
				"192.168.0.0/16",
			],
			"ip": [
				"*",
			],
		},
		// Family: one host on the home LAN. Uncomment together with group:family in groups.hujson.
		/*
		{
			"src": ["group:family"],
			"dst": ["192.168.0.3/32"],
			"ip":  ["*"],
		},
		*/
	],
}
