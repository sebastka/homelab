{
	// For the Kubernetes operator on talmox (k8s/infrastructure/network/tailscale): its OAuth
	// client (oauth_clients.tf) carries tag:k8s-operator, and only it may tag the devices it
	// creates, the Connector among them, with tag:k8s.
	// Empty list = nobody can self-apply the operator tag to a personal device.
	"tagOwners": {
		"tag:k8s-operator": [],
		"tag:k8s": [
			"tag:k8s-operator",
		],
	},
}
