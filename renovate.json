{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "k8s/**/charts/**"
  ],
  "prHourlyLimit": 10,
  "minimumReleaseAge": "3 days",
  "labels": ["renovate"],
  "semanticCommits": "enabled",
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    }
  ],
  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "sebastka",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ]
}
