{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "k8s/**/charts/**"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 25,
  "minimumReleaseAge": "1 day",
  "internalChecksAsSuccess": true,
  "platformAutomerge": true,
  "labels": ["renovate"],
  "semanticCommits": "enabled",
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "kustomize images: entries. The built-in kustomize manager ignores newTag and skips newTag+digest as invalid-dependency-specification, so these would never be updated (k8s/common/images, crowdsec, falco). Matches both {name: X, newTag: ...} and {name: X, newName: Y, newTag: ...}, with or without digest. Depends on the flow-style formatting used in this repo.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml$/"],
      "matchStrings": [
        "newName: (?<depName>[^,}]+), newTag: (?<currentValue>[^,}]+)(?:, digest: (?<currentDigest>sha256:[0-9a-f]+))?",
        "[{]name: (?<depName>[^,}]+), newTag: (?<currentValue>[^,}]+)(?:, digest: (?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/"],
      "matchStrings": [
        ":\\s*(?<currentValue>\\S+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["k8s/applications/dev/forgejo/kustomization\\.yaml"],
      "matchStrings": ["version:\\s*(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "gitea-releases",
      "depNameTemplate": "forgejo-helm/forgejo-helm",
      "registryUrlTemplate": "https://code.forgejo.org",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)kustomization\\.yaml$/"],
      "matchStrings": ["(?:releases/download/|[?&]ref=)(?<currentValue>v[^\\s/?&]+)[^\\s]*\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Grafana\\.yaml$/"],
      "matchStrings": ["'[^\\s']+\\s+(?<currentValue>[^\\s']+)'[^#]*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    },
    {
      "description": "The Grafana CR's version, a full image ref with digest (image:tag@sha256). The tag is a full major.minor.patch: config:recommended's workaround for grafana/grafana sets that versioning (with -security-NN releases) and overrides any versioningTemplate here",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Grafana\\.yaml$/"],
      "matchStrings": ["version:\\s*'(?<depName>[^':@]+):(?<currentValue>[^'@]+)@(?<currentDigest>sha256:[a-f0-9]{64})'\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)"],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)GrafanaDashboard\\.yaml$/"],
      "matchStrings": ["revision:\\s*(?<currentValue>\\d+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ,
    {
      "description": "Kubernetes image volumes (spec.volumes[].image.reference) - the kubernetes manager only reads image: as a scalar, so it never sees these",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Deployment[^/]*\\.yaml$/"],
      "matchStrings": ["reference:\\s*'[^']*:(?<currentValue>[^':\\s]+)'[^#\\n]*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    }
  ],
  "packageRules": [
    {
      "description": "Forgejo chart is tracked via the gitea-releases custom manager instead",
      "matchManagers": ["kustomize"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["code.forgejo.org/forgejo-helm/forgejo"],
      "enabled": false
    },
    {
      "description": "Automerge every non-major update, all ecosystems",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "bump"],
      "automerge": true
    },
    {
      "description": "Digest refreshes are rebuilds of an already-vetted tag",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Skip the stability delay for base images and self-built images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "docker.io/library/alpine",
        "docker.io/library/busybox",
        "docker.io/alpine/kubectl",
        "docker.io/alpine/curl",
        "docker.io/alpine/git",
        "docker.io/mikefarah/yq",
        "docker.io/nginxinc/nginx-unprivileged",
        "docker.io/valkey/valkey",
        "registry.k8s.io/kubectl",
        "registry.k8s.io/metrics-server/metrics-server",
        "ghcr.io/maxmind/geoipupdate",
        "ghcr.io/traefik/whoami",
        "docker.io/apache/tika",
        "docker.io/gotenberg/gotenberg",
        "ghcr.io/sebastka/**"
      ],
      "minimumReleaseAge": "0 days",
      "schedule": ["after 4am and before 6am"],
      "timezone": "Europe/Oslo"
    },
    {
      "description": "OCI registries publish no release timestamp, so minimumReleaseAge can never be satisfied and internalChecksFilter=strict withholds the PR forever. Classic https:// helm repos (index.yaml created) and docker.io (Hub API) are unaffected and keep the 1 day delay. See REVIEW.md item 22",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**", "quay.io/**", "registry.k8s.io/**", "registry.gitlab.com/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "The Grafana plugins datasource returns versions only, with no timestamp, so the same stall applies. Dashboards are unaffected: their revisions carry createdAt. Custom datasources are namespaced with a custom. prefix, matching the datasource= annotations in the manifests",
      "matchDatasources": ["custom.grafana-plugins"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[a-f0-9]+)$"
    },
    {
      "description": "Zabbix tags put the variant first (alpine-7.4.9), which docker versioning cannot parse: Renovate detected the images but never proposed an update",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/zabbix/zabbix-server-pgsql", "docker.io/zabbix/zabbix-web-nginx-pgsql"],
      "versioning": "regex:^alpine-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "v1.120.1 is a stray tag (built with v1.20.1, no matching release) that semver ranks above v1.20.x",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/victoriametrics/mcp-victoriametrics"],
      "allowedVersions": "<1.100.0"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/sebastka/carat"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[a-f0-9]+)$"
    },
    {
      "description": "Majors always need a human; keep them off automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Grafana dashboard revisions are plain integers, so every new one counts as a major; automerge them anyway. Kept after the majors rule, which it overrides",
      "matchDatasources": ["custom.grafana-dashboards"],
      "automerge": true
    }
  ],
  "customDatasources": {
    "grafana-plugins": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/plugins/{{packageName}}/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map(items, function($v) { {\"version\": $v.version} })]}"
      ]
    },
    "grafana-dashboards": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}/revisions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map(items, function($v) { {\"version\": $string($v.revision), \"releaseTimestamp\": $v.createdAt} })]}"
      ]
    }
  },
  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "sebastka",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "description": "Docker Hardened Images, direct-pull path (dhi.io). DHI authenticates with Docker Hub accounts, so this reuses the Docker Hub token above.",
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "sebastka",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "description": "ghcr.io/sebastka/carat is a private package, so anonymous lookups return no-result",
      "matchHost": "ghcr.io",
      "username": "sebastka",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ]
}
