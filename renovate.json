{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "k8s/**/charts/**"
  ],
  "prHourlyLimit": 10,
  "minimumReleaseAge": "3 days",
  "labels": ["renovate"],
  "semanticCommits": "enabled",
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[a-f0-9]+)$"
    },
  ],
  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "sebastka",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ]
}
