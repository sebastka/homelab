{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "k8s/**/charts/**"
  ],
  "prHourlyLimit": 10,
  "minimumReleaseAge": "3 days",
  "labels": ["renovate"],
  "semanticCommits": "enabled",
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/"],
      "matchStrings": [
        ":\\s*(?<currentValue>\\S+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Grafana\\.yaml$/"],
      "matchStrings": [
        "'[^\\s']+\\s+(?<currentValue>[^\\s']+)'[^#]*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[a-f0-9]+)$"
    },
  ],
  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "sebastka",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ]
}
