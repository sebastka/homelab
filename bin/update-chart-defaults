#!/bin/sh
# Fetch the upstream values.yaml and values.schema.json of every chart in a `helmCharts:` block,
# at the pinned version, and write them next to its valuesFile:
#
#   values.yaml          -> values.default.yaml, values.schema.json
#   values.<name>.yaml   -> values.<name>.default.yaml, values.<name>.schema.json
#
# Both are gitignored. The valuesFile's `# yaml-language-server: $schema=` line, if present, is
# pointed at the local schema. Run after a chart bump; pass directories to limit the search.
#
# Usage: update-chart-defaults [dir...]    (default: the k8s/ directory; bin/ is on PATH via .envrc)
set -u

main()
{
    for tool in helm yq; do
        command -v "$tool" >/dev/null || { printf -- 'Missing: %s\n' "$tool" >&2; return 1; }
    done

    [ $# -gt 0 ] || set -- "$(dirname "$0")/../k8s"

    tmp=$(mktemp -d) || return 1
    trap 'rm -rf "$tmp"' EXIT INT TERM

    rc=0
    for kustomization in $(find "$@" -name charts -prune -o -name kustomization.yaml -print | sort); do
        grep -q '^helmCharts:' "$kustomization" || continue
        # One tab-separated line per chart; entries without a repo are local charts.
        yq -r '.helmCharts[]? | select(.repo) | [.name, .repo, .version, .valuesFile // "values.yaml"] | @tsv' \
            "$kustomization" > "$tmp/charts" || { rc=1; continue; }

        while IFS="$(printf '\t')" read -r name repo version values; do
            [ -n "$name" ] || continue
            update_chart "$(dirname "$kustomization")" "$name" "$repo" "$version" "$values" || rc=1
        done < "$tmp/charts"
    done
    return $rc
}

update_chart()
{
    dir=$1 name=$2 repo=$3 version=$4 values=$5

    values_path="$dir/$values"
    base="${values_path%.yaml}"
    defaults="$base.default.yaml"
    schema="$base.schema.json"

    printf -- '%s %s (%s)\n' "$name" "$version" "$dir"

    rm -rf "$tmp/pull" && mkdir "$tmp/pull"
    case $repo in
        oci://*) set -- "${repo%/}/$name" ;;
        *)       set -- "$name" --repo "$repo" ;;
    esac
    # stdin is the chart list being read by main's loop.
    helm pull "$@" --version "$version" --untar --untardir "$tmp/pull" </dev/null >/dev/null || {
        printf -- '  ! helm pull failed\n' >&2
        return 1
    }
    chart="$tmp/pull/$name"

    # shellcheck disable=SC2016 # a literal $schema
    {
        [ -f "$chart/values.schema.json" ] && printf -- '# yaml-language-server: $schema=%s\n' "${schema##*/}"
        printf -- '# Upstream defaults of %s %s. Generated by bin/update-chart-defaults; do not edit.\n---\n' \
            "$name" "$version"
        cat "$chart/values.yaml"
    } > "$defaults"

    if [ -f "$chart/values.schema.json" ]; then
        cp "$chart/values.schema.json" "$schema"
        point_modeline "$values_path" "${schema##*/}"
    else
        rm -f "$schema"
        printf -- '  chart ships no values.schema.json\n'
    fi
}

# Rewrite an existing modeline only; a values file without one is left as it is.
point_modeline()
{
    [ -f "$1" ] || return 0
    # shellcheck disable=SC2016 # a literal $schema
    if head -n 1 "$1" | grep -q '^# yaml-language-server: \$schema='; then
        sed -i "1s|.*|# yaml-language-server: \$schema=$2|" "$1"
    else
        printf -- '  %s has no yaml-language-server modeline on line 1\n' "$1"
    fi
}

main "$@"
