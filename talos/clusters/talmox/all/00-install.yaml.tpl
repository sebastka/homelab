# yaml-language-server: $schema=https://raw.githubusercontent.com/siderolabs/talos/refs/heads/release-1.14/website/content/v1.14/schemas/config.schema.json
# Install disk, pinned by serial (nodes[].data.installDisk in topf.yaml), so that adding NVMe drives later can never
# move the install. `talosctl get disks` shows the serial.
# The installer *image* is generated by topf from platform/secureboot/schematicId/talosVersion,
# and merges into the document below.
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.serial == "{{ .Node.Data.installDisk }}"
  wipe: false
