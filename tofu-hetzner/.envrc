# Environment for tofu and run.sh.

# Keep anything exported by a parent .envrc.
source_up_if_exists

dotenv_if_exists .env

# Re-read the secrets when the file they come from changes.
watch_file secrets.sops.yaml

# Everything here lives in secrets.sops.yaml, so no credential is on disk in the clear. An
# already-set value wins, which keeps one-off overrides working. The first call prompts for the
# smartcard PIN; the rest come from gpg-agent's cache.
sops_export()
{
  eval "value=\${$2:-}"
  [ -n "$value" ] || value=$(sops -d --extract "[\"$1\"]" secrets.sops.yaml 2>/dev/null)
  [ -n "$value" ] || { log_error "could not read $1 from secrets.sops.yaml -- is the PGP key available?"; return 1; }
  export "$2=$value"
}

# State encryption is evaluated before variables are, so the passphrase has to arrive as a
# TF_VAR_ rather than through any provider or data source.
sops_export state_encryption_passphrase TF_VAR_state_encryption_passphrase

# The object storage key pair the provider authenticates with (Cloud Console → project → Security
# → S3 credentials). The provider reads these two variables itself.
sops_export s3_access_key MINIO_USER
sops_export s3_secret_key MINIO_PASSWORD

unset value
