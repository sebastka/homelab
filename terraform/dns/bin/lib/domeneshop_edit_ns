#!/bin/sh
set -eu

zone_id="$1"
ns1="$2"
ns2="$3"

curl --silent \
    -X POST \
    --cookie "sessionid=${DOMENESHOP_COOKIE}" \
    --data "auth=${DOMENESHOP_AUTH}" \
    --data "id=${zone_id}" \
    --data "edit=ns" \
    --data "ns1=${ns1}" \
    --data "ns2=${ns2}" \
    --data "ns3=" \
    --data "ns4=" \
    --data "ns5=" \
    --data "ns6=" \
    --data "check=Y" \
    --data "modify=Lagre+endringer" \
    "https://domene.shop/admin?id=${zone_id}&edit=ns"
