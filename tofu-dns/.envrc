# Environment for tofu and run.sh.

# Keep anything exported by a parent .envrc.
source_up_if_exists

dotenv_if_exists .env

# Re-read the secrets when the file they come from changes.
watch_file secrets.sops.yaml

# Everything here lives in secrets.sops.yaml rather than in a tfvars file, so
# no credential is on disk in the clear. An already-set value wins, which keeps
# CI and one-off overrides working. The first call prompts for the smartcard
# PIN; the rest come from gpg-agent's cache.
sops_export()
{
  eval "value=\${$2:-}"
  [ -n "$value" ] || value=$(sops -d --extract "[\"$1\"]" secrets.sops.yaml 2>/dev/null)
  [ -n "$value" ] || { log_error "could not read $1 from secrets.sops.yaml -- is the PGP key available?"; return 1; }
  export "$2=$value"
}

# State encryption is evaluated before variables are, so the passphrase cannot
# come from the sops data source the way the rest of secrets.sops.yaml does.
sops_export state_encryption_passphrase TF_VAR_state_encryption_passphrase

# The provider reads its token straight from the environment, so it does not
# need to be an OpenTofu variable at all.
sops_export cloudflare_api_token CLOUDFLARE_API_TOKEN

unset value
