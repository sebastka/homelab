# --- Monitored domains: DOMAIN_<n>_* for n = 1, 2, … (gaps are fine; n fixes the order) ---
# Every domain is checked (MX, SMTP, SPF, DKIM, DMARC, MTA-STS, TLS-RPT, DANE, BIMI, blocklists).
# With SMTP settings, it also sends a delivery test to every RECIPIENT_<n> every
# SEND_INTERVAL_MINUTES (default DELIVERY_INTERVAL_MINUTES). SMTP settings are all-or-nothing.

DOMAIN_1_NAME=karlsen.fr
DOMAIN_1_DKIM_SELECTORS=ds202503
# DOMAIN_1_SENDER_IPS=
# DOMAIN_1_SEND_INTERVAL_MINUTES=10080  # 10080 minutes = 7 days
# DOMAIN_1_SMTPHOST=smtp.domeneshop.no
# DOMAIN_1_SMTPPORT=465
# DOMAIN_1_SMTPUSER=
# DOMAIN_1_FROM=
# DOMAIN_1_SMTPPASS=

DOMAIN_2_NAME=karlsen.org
DOMAIN_2_DKIM_SELECTORS=ds202610
# DOMAIN_2_SENDER_IPS=
# DOMAIN_2_SEND_INTERVAL_MINUTES=10080  # 10080 minutes = 7 days
# DOMAIN_2_SMTPHOST=smtp.domeneshop.no
# DOMAIN_2_SMTPPORT=465
# DOMAIN_2_SMTPUSER=
# DOMAIN_2_FROM=
# DOMAIN_2_SMTPPASS=

DOMAIN_3_NAME=karlsen.app
# DOMAIN_3_DKIM_SELECTORS=
# DOMAIN_3_SENDER_IPS=
# DOMAIN_3_SEND_INTERVAL_MINUTES=
# DOMAIN_3_SMTPHOST=
# DOMAIN_3_SMTPPORT=
# DOMAIN_3_SMTPUSER=
# DOMAIN_3_FROM=
# DOMAIN_3_SMTPPASS=
