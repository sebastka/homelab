# --- Delivery test recipients: RECIPIENT_<n>_* ---
# Dedicated test mailboxes at the providers you want to reach. MailWatch searches the Inbox and
# the Junk folder for its test messages, records where and how fast they arrived and how the
# provider authenticated them, then moves them to the trash.

# RECIPIENT_1_NAME=GMail
# RECIPIENT_1_IMAPHOST=imap.gmail.com
# RECIPIENT_1_IMAPPORT=993
# RECIPIENT_1_IMAPUSER=mygmailuser@gmail.com
# RECIPIENT_1_IMAPPASSWORD=change-me     # a Google app password (needs 2-step verification); _IMAPPASS works too
# RECIPIENT_1_ADDRESS=mygmailuser@gmail.com  # default: IMAPUSER
# RECIPIENT_1_FOLDERS=INBOX,[Gmail]/Spam     # default: INBOX + the folder marked \Junk
# RECIPIENT_1_KEEP_MESSAGES=false            # true = leave found test messages in place

# Outlook.com no longer accepts passwords over IMAP: use OAuth2 (XOAUTH2) with a refresh token
# of an app registration that has the IMAP.AccessAsUser.All permission (see README).
# RECIPIENT_2_NAME=Microsoft
# RECIPIENT_2_IMAPHOST=outlook.office365.com
# RECIPIENT_2_IMAPPORT=993
# RECIPIENT_2_IMAPUSER=myoutlookuser@outlook.com
# RECIPIENT_2_OAUTH_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token
# RECIPIENT_2_OAUTH_CLIENT_ID=change-me
# RECIPIENT_2_OAUTH_REFRESH_TOKEN=change-me
# RECIPIENT_2_OAUTH_CLIENT_SECRET=      # confidential clients only
# RECIPIENT_2_OAUTH_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access
