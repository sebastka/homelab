# --- Report mailboxes: MAILBOX_<n>_* ---
# Mailboxes receiving DMARC aggregate (rua), DMARC failure (ruf) and SMTP TLS (TLS-RPT) reports.
# One mailbox may receive all kinds; each message is classified by its content. Read-only,
# except for the opt-in cleanup.

# Karlsen.fr - RUF mailbox
MAILBOX_1_NAME=Karlsen.fr - RUF Reports
MAILBOX_1_IMAPHOST=imap.domeneshop.no
MAILBOX_1_IMAPPORT=993
# MAILBOX_1_IMAPUSER=
# MAILBOX_1_ADDRESS=
MAILBOX_1_FOLDER=INBOX/ruf
MAILBOX_1_DELETE_AFTER_MONTHS=12

# Karlsen.fr - RUA mailbox
MAILBOX_2_NAME=Karlsen.fr - RUA Reports
MAILBOX_2_IMAPHOST=imap.domeneshop.no
MAILBOX_2_IMAPPORT=993
# MAILBOX_2_IMAPUSER=
# MAILBOX_2_ADDRESS=
MAILBOX_2_FOLDER=INBOX/rua
MAILBOX_2_DELETE_AFTER_MONTHS=12

# Karlsen.fr - TLS-RPT mailbox
MAILBOX_3_NAME=Karlsen.fr - TLS-RPT Reports
MAILBOX_3_IMAPHOST=imap.domeneshop.no
MAILBOX_3_IMAPPORT=993
# MAILBOX_3_IMAPUSER=
# MAILBOX_3_ADDRESS=
MAILBOX_3_FOLDER=INBOX/tlsrpt
MAILBOX_3_DELETE_AFTER_MONTHS=12

