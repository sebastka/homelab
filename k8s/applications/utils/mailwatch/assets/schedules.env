# --- Schedules ---

 # DNS and server checks of every domain; 0 = manual only
CHECK_INTERVAL_MINUTES=60

# domains checked in parallel
CHECK_CONCURRENCY=2

# report mailboxes; 0 = manual / CLI only
REPORT_SYNC_INTERVAL_MINUTES=30

# report findings and their alerts look at this many days
REPORT_ANALYSIS_DAYS=7

# # warn when reports stop for this many days (after 30 days with reports); 0 = off
REPORT_SILENT_DAYS=15

# default send interval of every sender domain
# DELIVERY_INTERVAL_MINUTES=60

# a test message not found after this long is "lost"
# DELIVERY_TIMEOUT_MINUTES=30

# how often recipients are searched while messages are pending
# DELIVERY_POLL_SECONDS=60

# delete older delivery results; 0 = keep
# DELIVERY_RETENTION_DAYS=90
