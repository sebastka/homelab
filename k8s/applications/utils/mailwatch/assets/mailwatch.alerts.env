# --- Alerts ---

# consecutive checks a finding must be seen in before it alerts
ALERT_CONFIRMATIONS=2                  

# Telegram: alerts are posted by this bot to this chat (optional; both or neither)
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=42                  # topic in a forum supergroup, optional

# # times in the UI and in alerts, and quiet hours
TIMEZONE=Europe/Oslo
