# --- Checks ---

# validating resolvers (DNSSEC); "system" = the OS resolvers
DNS_RESOLVERS=1.1.1.1,8.8.8.8

DNS_TIMEOUT_MS=4000

# connect to every MX on port 25 (STARTTLS, certificates, DANE)
SMTP_PROBE=true
SMTP_PROBE_TIMEOUT_MS=20000
# SMTP_HELO_NAME=mailwatch.karlsen.app # default: the PUBLIC_URL host name

# certificate expiry warning (7 days = error)
CERT_WARN_DAYS=21

# MTA-STS policy, BIMI, RDAP and autoconfig fetches
HTTP_TIMEOUT_MS=2000

# registration data (expiry, status) via RDAP, at most once a day per domain
RDAP_CHECK=true

# domain expiry warning (7 days = error)
REGISTRATION_WARN_DAYS=30

# query every nameserver directly (lame delegation, SOA serials)
NS_CHECK=true

# RRSIG expiry warning (also needs < 1/4 of the validity left)    
DNSSEC_SIG_WARN_DAYS=3

# warn about DKIM keys unchanged for longer (counted from first sighting); 0 = off
DKIM_KEY_MAX_AGE_DAYS=365

# selectors tried for every domain; empty = only configured/seen ones
# DKIM_COMMON_SELECTORS=default,dkim,

# Spamhaus and SURBL refuse queries through public resolvers: use your own resolver or a key
# DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net,psbl.surriel.com,bl.mailspike.net
# DNSBL_DOMAIN_ZONES=dbl.spamhaus.org,multi.surbl.org

# default: DNS_RESOLVERS; "system" = the OS resolvers
DNSBL_RESOLVERS=192.168.0.1

# free for low volume; zen.spamhaus.org is then queried as <key>.zen.dq.spamhaus.net
# SPAMHAUS_DQS_KEY=change-me
