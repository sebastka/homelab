# --- OIDC login (required: the dashboard does not start without it) ---

# Register the redirect URI ${PUBLIC_URL}/auth/callback and post-logout URI ${PUBLIC_URL}/

PUBLIC_URL=https://mailwatch.karlsen.app
OIDC_ISSUER=https://auth.karlsen.fr
OIDC_CLIENT_ID=mailwatch
# OIDC_CLIENT_SECRET=

# or client_secret_post, client_secret_jwt, none (public client, no secret)
OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# comma/space separated; members of any of them get in
# may change settings and send delivery tests on demand; unset = everyone allowed
OIDC_ALLOWED_GROUPS=k8s_admins

# or a nested path, e.g. realm_access.roles
# OIDC_GROUPS_CLAIM=groups 

# some providers need "groups" added to send the claim
OIDC_SCOPES=openid profile email groups

# SESSION_TTL_HOURS=12
