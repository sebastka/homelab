# https://docs.paperless-ngx.com/configuration/

# DEBUG=True

#
# Required services
#

## Redis Broker
PAPERLESS_REDIS=redis://valkey:6379
PAPERLESS_REDIS_PREFIX=paperless_

## Database
PAPERLESS_DBHOST=paperless-db-rw.cnpg-database.svc.cluster.local
PAPERLESS_DBENGINE=postgresql
# PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
# PAPERLESS_DBPASS=  # Secret
# PAPERLESS_DBSSLMODE=disable
# PAPERLESS_DB_POOLSIZE=10

#
# Optional Services
#

## Tika
PAPERLESS_TIKA_ENABLED=true
PAPERLESS_TIKA_ENDPOINT=http://tika:80
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:80

# Email parsing
# PAPERLESS_EMAIL_PARSE_DEFAULT_LAYOUT=

#
# Paths and folders
#

PAPERLESS_CONSUMPTION_DIR=/usr/src/paperless/consume
PAPERLESS_DATA_DIR=/usr/src/paperless/data
PAPERLESS_EMPTY_TRASH_DIR=/usr/src/paperless/media/trash
PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
# PAPERLESS_STATICDIR=
# PAPERLESS_FILENAME_FORMAT={{ correspondent }}/{{ created }}.{{ title }}
# PAPERLESS_LOGGING_DIR=/usr/src/paperless/data/logs

#
# Logging
#

# PAPERLESS_LOGROTATE_MAX_SIZE=
# PAPERLESS_LOGROTATE_MAX_BACKUPS=20

#
# Hosting & Security
#

# PAPERLESS_SECRET_KEY=  # Secret
PAPERLESS_URL=https://paperless.karlsen.app
# PAPERLESS_TRUSTED_PROXIES=
# PAPERLESS_CORS_ALLOWED_HOSTS=
PAPERLESS_ADMIN_USER=sebastian
PAPERLESS_ADMIN_MAIL=sebastian@karlsen.fr
# PAPERLESS_ADMIN_PASSWORD=  # Secret
# PAPERLESS_COOKIE_PREFIX=__Host-

#
# Authentication & SSO
#

PAPERLESS_ACCOUNT_ALLOW_SIGNUPS=false

#
# OCR settings
#

PAPERLESS_OCR_LANGUAGE=nor
# PAPERLESS_OCR_MODE=skip
# PAPERLESS_OCR_SKIP_ARCHIVE_FILE=never
# PAPERLESS_OCR_CLEAN=clean

#
# Software tweaks
#

PAPERLESS_TASK_WORKERS=1
# PAPERLESS_THREADS_PER_WORKER
PAPERLESS_TIME_ZONE=Europe/Oslo
# PAPERLESS_NLTK_DIR=true
PAPERLESS_DATE_PARSER_LANGUAGES=nb+en
# PAPERLESS_TRAIN_TASK_CRON=
# PAPERLESS_INDEX_TASK_CRON=
# PAPERLESS_SANITY_TASK_CRON=
# PAPERLESS_WORKFLOW_SCHEDULED_TASK_CRON=
# PAPERLESS_APPS=
PAPERLESS_OCR_USER_ARGS='{"invalidate_digital_signatures": true}'

#
# Document Consumption
#

# PAPERLESS_CONSUMER_DISABLE=
# PAPERLESS_POST_CONSUME_SCRIPT=/scripts/post-consumption.sh
# PAPERLESS_ENABLE_GPG_DECRYPTOR=

## Polling
PAPERLESS_CONSUMER_POLLING=10

## iNotify
# PAPERLESS_CONSUMER_INOTIFY_DELAY=

#
# Workflow webhooks
#

# PAPERLESS_WEBHOOKS_ALLOWED_SCHEMES=
# PAPERLESS_WEBHOOKS_ALLOWED_PORTS=
# PAPERLESS_WEBHOOKS_ALLOW_INTERNAL_REQUESTS=

#
# Incoming Mail
#

## Email OAuth
# PAPERLESS_OAUTH_CALLBACK_BASE_URL=

## Encrypted Emails
# PAPERLESS_EMAIL_GNUPG_HOME=

#
# Barcodes
#

# PAPERLESS_CONSUMER_ENABLE_BARCODES=false

#
# Audit Trail
#

# PAPERLESS_AUDIT_LOG_ENABLED=true

#
# Collate Double-Sided Documents
#

# PAPERLESS_CONSUMER_ENABLE_COLLATE_DOUBLE_SIDED=false

#
# Trash
#

# PAPERLESS_EMPTY_TRASH_DELAY=30
# PAPERLESS_EMPTY_TRASH_TASK_CRON=

#
# Binaries
#

# PAPERLESS_CONVERT_BINARY=convert
# PAPERLESS_GS_BINARY=gs

#
# Docker-specific options
#

PAPERLESS_WEBSERVER_WORKERS=1
GRANIAN_WORKERS=1
PAPERLESS_BIND_ADDR=0.0.0.0
GRANIAN_HOST=0.0.0.0
PAPERLESS_PORT=8000
GRANIAN_PORT=8000
USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_OCR_LANGUAGES=nor
# PAPERLESS_ENABLE_FLOWER=true

#
# Frontend Settings
#

# PAPERLESS_APP_TITLE=Paperless-ngx

#
# Email sending
#

PAPERLESS_EMAIL_HOST=smtp.domeneshop.no
PAPERLESS_EMAIL_PORT=465
PAPERLESS_EMAIL_HOST_USER=karlsenfr1
PAPERLESS_EMAIL_FROM=noreply@karlsen.fr
# PAPERLESS_EMAIL_HOST_PASSWORD=  # Secret
PAPERLESS_EMAIL_USE_TLS=false
PAPERLESS_EMAIL_USE_SSL=true

#
# Custom settings
# See assets/extra_settings.py
#

PAPERLESS_CUSTOM_ENABLE=false
# PAPERLESS_CUSTOM_COOKIE_DOMAIN=
PAPERLESS_CUSTOM_COOKIE_HTTPONLY=true
# PAPERLESS_CUSTOM_COOKIE_PATH=/
PAPERLESS_CUSTOM_COOKIE_SAMESITE=Strict
PAPERLESS_CUSTOM_COOKIE_SECURE=true
