# The docker image sets its own defaults on these values,
# which overwrite values in base.toml. Therefore, set them here as well.

# REDIS_PORT=6379
# POSTGRES_PASSWORD=postgres
# DOCKER=1
# PORT=8080
PORT=3000
# FFPROBE_PATH=/usr/bin/ffprobe
# REDIS_HOST=redis_db
REDIS_HOST=valkey
POSTGRES_DB=ott
# POSTGRES_HOST=postgres_db
POSTGRES_HOST=db02.hera.home.karlsen.fr
POSTGRES_USER=ott
# PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# NODE_VERSION=20.20.0
# YARN_VERSION=1.22.22
NODE_ENV=production
