# https://github.com/alexta69/metube/tree/master

# Download behavior
MAX_CONCURRENT_DOWNLOADS=3
DELETE_FILE_ON_TRASHCAN=true
DEFAULT_OPTION_PLAYLIST_ITEM_LIMIT=0
SUBSCRIPTION_DEFAULT_CHECK_INTERVAL=60
SUBSCRIPTION_SCAN_PLAYLIST_END=50
SUBSCRIPTION_MAX_SEEN_IDS=5000
CLEAR_COMPLETED_AFTER=0

# Storage & Directories
DOWNLOAD_DIR=/mnt/persistent/downloads
AUDIO_DOWNLOAD_DIR=/mnt/persistent/downloads/audio
CUSTOM_DIRS=true
CREATE_CUSTOM_DIRS=true
CUSTOM_DIRS_EXCLUDE_REGEX=(^|/)[.@].*$
DOWNLOAD_DIRS_INDEXABLE=false
STATE_DIR=/mnt/persistent/state
TEMP_DIR=/mnt/persistent/temp
CHOWN_DIRS=false

# File Naming & yt-dlp

# Web Server & URLs
# HOST=
# PORT=
# URL_PREFIX=
# PUBLIC_HOST_URL=
# PUBLIC_HOST_AUDIO_URL=
# HTTPS=
# CERTFILE=
# KEYFILE=
CORS_ALLOWED_ORIGINS=*
# ROBOTS_TXT=

# Basic Setup
# PUID=
# PGID=
# UMASK=
# DEFAULT_THEME=auto
# LOGLEVEL=INFO
# ENABLE_ACCESSLOG=false

# yt-dlp options
# YTDL_OPTIONS=
YTDL_OPTIONS_FILE=/mnt/ytdl-options.json
# {
#   "writesubtitles": true,
#   "subtitleslangs": ["en", "de"],
#   "updatetime": false,
#   "writethumbnail": true
# }
# YTDL_OPTIONS_PRESETS_FILE=ytdl-options-presets.json
# {
#   "sponsorblock": {
#     "postprocessors": [
#       { "key": "SponsorBlock", "categories": ["sponsor", "selfpromo", "interaction"] },
#       { "key": "ModifyChapters", "remove_sponsor_segments": ["sponsor", "selfpromo", "interaction"] }
#     ]
#   },
#   "embed-subs": {
#     "writesubtitles": true,
#     "writeautomaticsub": true,
#     "subtitleslangs": ["en", "de"],
#     "postprocessors": [{ "key": "FFmpegEmbedSubtitle" }]
#   },
#   "limit-rate": {
#     "ratelimit": 5000000
#   }
# }
ALLOW_YTDL_OPTIONS_OVERRIDES=true
