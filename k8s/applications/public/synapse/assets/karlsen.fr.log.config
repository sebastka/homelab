# https://github.com/element-hq/synapse/blob/develop/docker/conf/log.config

version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s- %(message)s'

filters:
  context:
    (): synapse.util.logcontext.LoggingContextFilter
    request: ""

handlers:
  file:
    class: logging.handlers.RotatingFileHandler
    formatter: precise
    filename: /var/log/homeserver.log
    filters: [context]
    level: INFO
  console:
    class: logging.StreamHandler
    formatter: precise
    level: WARN

loggers:
  synapse:
    level: INFO

  synapse.storage.SQL:
    level: INFO

root:
  level: INFO
  handlers: [file, console]
