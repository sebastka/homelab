TZ=Europe/Oslo
ORIGIN=https://slink.karlsen.app

###> App Settings ###
USER_ALLOW_REGISTRATION=false
USER_ALLOW_UNAUTHENTICATED_ACCESS=true
USER_APPROVAL_REQUIRED=true
USER_PASSWORD_MIN_LENGTH=48
USER_PASSWORD_REQUIREMENTS=15
IMAGE_MAX_SIZE=49M

# Image Settings
IMAGE_STRIP_EXIF_METADATA=true
IMAGE_ALLOW_ONLY_PUBLIC_IMAGES=false
IMAGE_ALLOW_GUEST_UPLOADS=false
IMAGE_COMPRESSION_QUALITY=80
IMAGE_ENABLE_DEDUPLICATION=true
IMAGE_ENABLE_LICENSING=false
IMAGE_FORCE_FORMAT_CONVERSION=false
IMAGE_TARGET_FORMAT=webp
IMAGE_CONVERT_ANIMATED_IMAGES=false
REQUIRE_SSL=false
SHARE_ENABLE_URL_SHORTENING=true
