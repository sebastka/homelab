# https://github.com/sebastka/tlsrpt#configuration
# Secrets (IMAP_PASSWORD, DB_PASSWORD, OIDC_CLIENT_SECRET) are in Secret/tlsrpt

# HTTP
LISTEN_HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://tlsrpt.karlsen.app
SYNC_INTERVAL_MINUTES=30

# IMAP mailbox receiving the TLSRPT reports
IMAP_HOST=imap.domeneshop.no
IMAP_PORT=993
IMAP_USERNAME=tlsrpt@inbox.com
IMAP_DIR=INBOX

# MariaDB
DB_HOST=db01.hera.home.karlsen.fr
DB_PORT=3306
DB_USER=tlsrpt
DB_NAME=tlsrpt

# OIDC (Authelia client `tlsrpt`)
OIDC_ISSUER=https://auth.karlsen.fr
OIDC_CLIENT_ID=tlsrpt
OIDC_SCOPES=openid profile email groups
OIDC_ALLOWED_GROUPS=k8s_admins
