      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum by (namespace) (count_over_time({cluster=\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" [$__interval]))",
          "instant": false,
          "legendFormat": "{{namespace}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${datasource}"},
      "gridPos": {"h": 32, "w": 24, "x": 0, "y": 6},
