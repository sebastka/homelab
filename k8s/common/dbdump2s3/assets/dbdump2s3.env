# Settings shared by every dbdump2s3 CronJob (k8s/common/dbdump2s3). Engine-specific ones (DUMP_KIND,
# DB_HOST) come from each overlay's dbdump2s3-env.
#
# PGP_RECIPIENT is the PUBLIC key of sebastian@karlsen.fr (0B25B26C537B40B5B208F3A6C74C02E66D0CBECF),
# base64: gpg --armor --export <fingerprint> | base64 -w0. The private key never enters the cluster,
# so a compromised pod can write backups it cannot read.
ENCRYPTION=pgp
# The bucket and its retention (lifecycle rules) are in tofu-hetzner/buckets.tf
S3_BUCKET=sebastka-homelab-databases
# Lock every uploaded version for 30 days, and check it: COMPLIANCE, which nobody can lift (see
# tofu-hetzner/buckets.tf). Set per upload rather than trusting the bucket's default retention,
# which Hetzner applied to only some uploads (tested 2026-10-18).
OBJECT_LOCK_DAYS=30
OBJECT_LOCK_MODE=COMPLIANCE
S3_ENDPOINT=https://hel1.your-objectstorage.com
AWS_DEFAULT_REGION=hel1
CLUSTER=talmox
DATABASES_CSV=/mnt/users-databases/databases.csv
USERS_CSV=/mnt/users-databases/users.csv
PASSWORD_DIR=/mnt/passwords
WORKDIR=/tmp
PGP_
